tion init() {\n    if (isInitialized) return;\n    isInitialized = true;\n    var banner = document.querySelector('.cookieBanner');\n    if (!banner) return;\n    if (checkConsent()) {\n      banner.style.display = 'none';\n    } else {\n      showBanner();\n      document.addEventListener('click', handleGlobalClick, true);\n    }\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    setTimeout(init, 100);\n  }\n})();\n</script>"},{"id":"rec828337470","type":"131","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":null,"padding-bottom":null},"uc":[],"hooks":[],"popupRecs":[],"custom":"<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n    // Определяем текущий URL\n    const urlParams = new URLSearchParams(window.location.search);\n    const rParam = urlParams.get('r'); // Получаем значение параметра r\n\n    // Если параметр r присутствует\n    if (rParam) {\n        // Находим блок меню по ID (замените ID на ваш)\n        const menuBlock = document.querySelector('#rec592229670'); // Замените на ID вашего ME403 блока\n        if (menuBlock) {\n            const links = menuBlock.querySelectorAll('a'); // Все ссылки внутри блока меню\n            links.forEach(link => {\n                const href = link.getAttribute('href'); // Получаем href ссылки\n                if (href && href.startsWith(\"https://popovichfit.ru/\")) {\n                    // Проверяем, содержит ли уже ссылка параметр ?r=\n                    const url = new URL(href);\n                    url.searchParams.set('r', rParam); // Устанавливаем/заменяем параметр r\n                    link.setAttribute('href', url.toString()); // Обновляем href ссылки\n                }\n            });\n        }\n    }\n});\n</script>"},{"id":"rec612152022","type":"670","vis":{"min":null,"max":null},"bg":"#e5e5e7","pad":{"padding-top":105,"padding-bottom":30},"uc":[],"html":"<div class=\"t670\"> <div class=\"t-s