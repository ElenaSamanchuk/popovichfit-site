er.visible {\n    opacity: 1;\n    transform: translateY(0);\n    transition: opacity 0.4s ease, transform 0.4s ease;\n  }\n</style> <script>\n(function() {\n  'use strict';\n  var STORAGE_KEY = 'cookieConsent';\n  var STORAGE_DATE_KEY = 'cookieConsentDate';\n  var isInitialized = false;\n  function checkConsent() {\n    return localStorage.getItem(STORAGE_KEY) === 'accepted';\n  }\n  function saveConsent() {\n    localStorage.setItem(STORAGE_KEY, 'accepted');\n    localStorage.setItem(STORAGE_DATE_KEY, new Date().toISOString());\n  }\n  function hideBanner() {\n    var banner = document.querySelector('.cookieBanner');\n    if (!banner) return;\n    banner.classList.remove('visible');\n    banner.classList.add('hidden');\n    document.removeEventListener('click', handleGlobalClick, true);\n    setTimeout(function() {\n      banner.style.display = 'none';\n    }, 400);\n  }\n  function showBanner() {\n    var banner = document.querySelector('.cookieBanner');\n    if (!banner) return;\n    banner.style.display = 'block';\n    setTimeout(function() {\n      banner.classList.add('visible');\n    }, 10);\n  }\n  function isPolicyLinkClick(element) {\n    var current = element;\n    while (current && current !== document.body) {\n      if (current.classList && current.classList.contains('cookie-banner-link')) {\n        return true;\n      }\n      current = current.parentElement;\n    }\n    return false;\n  }\n  function handleGlobalClick(event) {\n    if (isPolicyLinkClick(event.target)) {\n      return;\n    }\n    saveConsent();\n    hideBanner();\n  }\n  function init() {\n    if (isInitialized) return;\n    isInitialized = true;\n    var banner = document.querySelector('.cookieBanner');\n    if (!banner) return;\n    if (checkConsent()) {\n      banner.style.display = 'none';\n    } else {\n      showBanner();\n      document.addEventListener('click', handleGlobalClick, true);\n    }\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('D