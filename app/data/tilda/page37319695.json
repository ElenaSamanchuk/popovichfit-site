width":"var(--t396-borderwidth,0)","background-position":"center center","background-size":"cover"}}},"fields":{"axisy":"top","axisx":"left","container":"grid"},"anim":{},"html":"Холка: почему возникает и что поможет избавиться","text":"Холка: почему возникает и что поможет избавиться","tag":"h1","flex":false}],"groups":[],"tree":[{"kind":"elem","id":"1674476238540"},{"kind":"elem","id":"1669372132956"}]},{"id":"rec602944849","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":60,"padding-bottom":60},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \"><strong>Холка образуется на уровне 7-го шейного позвонка — это граница шейного и грудного отделов. </strong><span style=\"font-weight: 300;\">В этом месте образуется «выступ» из-за того, что голова смещается вперед и запрокидывается назад, лопатки поднимаются вверх и отодвигаются друг от друга </span><strong>— здесь внешне можно увидеть осанку по типу «сутулости». </strong></div> </div> </div> </div>","css":"#rec602944849 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602947087","type":"3","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":0},"uc":[],"html":"<div class=\"t107\"> <div class=\"t-align_center\" itemscope itemtype=\"http://schema.org/ImageObject\"> <meta itemprop=\"image\" content=\"/img/t/t37616537-frame_1.webp\"> <img class=\"t-img t-width t107__width t-width_8\" src=\"/img/t/t37616537-frame_1.webp\" imgfield=\"img\" data-zoomable=\"yes\" data-img-zoom-url=\"images/tild3761-6537-4965-b530-313833636263__frame_1.png\" alt=\"\"> </div> </div>","hooks":[],"popupRecs":[]},{"id":"rec602947048","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":60,"padding-bottom":60},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \"><span style=\"font-weight: 300;\">В данном варианте верхне-грудной отдел практически обездвижен и любые попытки «расправить плечи» (а сделать это хочется постоянно, потому что человек испытывает перманентное напряжение и дискомфорт в районе шеи) приводят к тому, что голова ещё больше запрокидывается назад, а в районе поясницы формируется прогиб. Это приводит и к «выпирающему» животу, и болям в районе спины.</span></div> </div> </div> </div>","css":"#rec602947048 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602944850","type":"3","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":0},"uc":[],"html":"<div class=\"t107\"> <div class=\"t-align_center\" itemscope itemtype=\"http://schema.org/ImageObject\"> <meta itemprop=\"image\" content=\"/img/t/t31373234-photo_2023-06-10_14-.webp\"> <img class=\"t-img t-width t107__width t-width_8\" src=\"/img/t/t31373234-photo_2023-06-10_14-.webp\" imgfield=\"img\" data-zoomable=\"yes\" data-img-zoom-url=\"images/tild3137-3234-4130-a535-626139653433__photo_2023-06-10_14-.jpg\" alt=\"\"> </div> </div>","hooks":[],"popupRecs":[]},{"id":"rec602949430","type":"223","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":30,"padding-bottom":0},"uc":[],"html":"<div class=\"t195\"> <div class=\"t-container\"> <div class=\"t-col t-col_4 t-prefix_2\"> <div class=\"t195__text t-text t-text_md\" field=\"text\"><strong>Осанка </strong>— это бессознательный процесс, который регулируется нервной системой и команда «расправь плечи» здесь, увы, не поможет<br /><br />Я неоднократно говорила, что наше тело максимально адаптируется под любые условия и помогает подстроиться всему опорно-двигательному аппарату — здесь как раз такая ситуация</div> </div> <div class=\"t-col t-col_4 t-prefix_1 t195__imgsection\" itemscope itemtype=\"http://schema.org/ImageObject\"><meta itemprop=\"image\" content=\"/img/t/t64313962-photo_2023-06-10_14-.webp\"> <img class=\"t195__img t-img\" src=\"/img/t/t64313962-photo_2023-06-10_14-.webp\" imgfield=\"img\" data-tu-max-width=\"1200\" data-tu-max-height=\"1200\" data-zoomable=\"yes\" data-img-zoom-url=\"images/tild6431-3962-4736-a533-656364656336__photo_2023-06-10_14-.jpg\" alt=\"\"><br /> <div class=\"t195__sectitle t-descr\" field=\"imgtitle\" itemprop=\"name\"></div> <div class=\"t195__secdescr t-descr\" field=\"imgdescr\" itemprop=\"description\"></div> </div> </div> </div>","hooks":[],"popupRecs":[]},{"id":"rec602949968","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":30,"padding-bottom":45},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \"><strong>Холка </strong>— одна из самых часто-встречаемых проблем нашего времени<br /><br />Как много времени мы проводим, опустив голову в телефон, работаем за компьютером<br /><br />Голова в среднем весит ~5 кг. Когда она смещается вперёд, её вес становится ещё тяжелее, шее как-то нужно удерживать голову <span style=\"font-weight: 600; background-color: transparent;\">→</span><span style=\"background-color: transparent;\"> мышцы находятся в диком напряжении — они пытаются «тянуть» шею назад, как канаты, чтобы голова не упала вперёд.</span></div> </div> </div> </div>","css":"#rec602949968 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602949995","type":"3","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":0},"uc":[],"html":"<div class=\"t107\"> <div class=\"t-align_center\" itemscope itemtype=\"http://schema.org/ImageObject\"> <meta itemprop=\"image\" content=\"/img/t/t64623561-photo_2023-06-10_14-.webp\"> <img class=\"t-img t-width t107__width t-width_8\" src=\"/img/t/t64623561-photo_2023-06-10_14-.webp\" imgfield=\"img\" data-zoomable=\"yes\" data-img-zoom-url=\"images/tild6462-3561-4066-a330-646133616366__photo_2023-06-10_14-.jpg\" alt=\"\"> </div> </div>","hooks":[],"popupRecs":[]},{"id":"rec602948916","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":45,"padding-bottom":45},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \">Меняется осанка, биомеханика движения: плечи завернуты внутрь, телу очень тяжело удерживать голову в вертикали. И на уровне 7-го шейного позвонка происходит разрастание соединительной ткани, чтобы <strong>облегчить задачу мышцам</strong>: тело таким образом помогает — так как голова должна быть вертикальна, а глаза должны быть на линии горизонта. Также появляются боли в районе шеи, верхней части спины, постоянное желание «помять»</div> </div> </div> </div>","css":"#rec602948916 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602950081","type":"3","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":0},"uc":[],"html":"<div class=\"t107\"> <div class=\"t-align_center\" itemscope itemtype=\"http://schema.org/ImageObject\"> <meta itemprop=\"image\" content=\"/img/t/t33333331-photo_2023-06-10_14-.webp\"> <img class=\"t-img t-width t107__width t-width_8\" src=\"/img/t/t33333331-photo_2023-06-10_14-.webp\" imgfield=\"img\" data-zoomable=\"yes\" data-img-zoom-url=\"images/tild3333-3331-4437-a434-333933386430__photo_2023-06-10_14-.jpg\" alt=\"\"> </div> </div>","hooks":[],"popupRecs":[]},{"id":"rec602950249","type":"223","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":60,"padding-bottom":30},"uc":[],"html":"<div class=\"t195\"> <div class=\"t-container\"> <div class=\"t-col t-col_4 t-prefix_2\"> <div class=\"t195__text t-text t-text_md\" field=\"text\"><strong>Конечно, внешний вид самой шеи тоже меняется. </strong>Поскольку грудино-ключично-сосцевидные мышцы спереди находятся в укорочении, все стянуто — страдает эстетика, мы видим «поплывший» овал лица</div> </div> <div class=\"t-col t-col_4 t-prefix_1 t195__imgsection\" itemscope itemtype=\"http://schema.org/ImageObject\"><meta itemprop=\"image\" content=\"/img/t/t34643530-photo_2023-06-10_14-.webp\"> <img class=\"t195__img t-img\" src=\"/img/t/t34643530-photo_2023-06-10_14-.webp\" imgfield=\"img\" data-tu-max-width=\"1200\" data-tu-max-height=\"1200\" data-zoomable=\"yes\" data-img-zoom-url=\"images/tild3464-3530-4338-a135-396338336265__photo_2023-06-10_14-.jpg\" alt=\"\"><br /> <div class=\"t195__sectitle t-descr\" field=\"imgtitle\" itemprop=\"name\"></div> <div class=\"t195__secdescr t-descr\" field=\"imgdescr\" itemprop=\"description\"></div> </div> </div> </div>","hooks":[],"popupRecs":[]},{"id":"rec603265755","type":"4","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":60,"padding-bottom":60},"uc":[],"html":"<div class=\"t121\"> <center> <div class=\"t-width t-width_8\"> <div class=\"t121__wrap-video\"> <div class=\"t-video-lazyload\" data-videolazy-load=\"false\" data-blocklazy-id=\"603265755\" data-videolazy-type=\"kinescope\" data-videolazy-id=\"dSXPmbcNFqAn7p9xLML5sX\" data-videolazy-height=\"540px\"> </div> </div> </div> </center> </div>","css":"#rec603265755 .t-video-lazyload{height:540px;}","hooks":[],"popupRecs":[]},{"id":"rec602950706","type":"33","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":15,"padding-bottom":30},"uc":[],"html":"<div class=\"t017\"> <div class=\"t-container t-align_left\"> <div class=\"t-col t-col_8 t-prefix_2\"> <div class=\"t017__title t-title t-title_xxs\" field=\"title\">Холка не «разбивается» массажем</div> </div> </div> </div>","css":"#rec602950706 .t017__title{font-family:'Manrope';font-weight:600;}","hooks":[],"popupRecs":[]},{"id":"rec602949354","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":45},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \"><strong>Вы вроде бы ходите на массаж, но ситуация не меняется. </strong>Что же нужно делать и как себе реально помочь? Ведь это не только «не здорОво», но и некрасиво</div> </div> </div> </div>","css":"#rec602949354 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602950808","type":"33","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":15},"uc":[],"html":"<div class=\"t017\"> <div class=\"t-container t-align_left\"> <div class=\"t-col t-col_8 t-prefix_2\"> <h2 class=\"t017__title t-title t-title_xxs\" field=\"title\">1. Работать с телом комплексно:</h2> </div> </div> </div>","css":"#rec602950808 .t017__title{font-family:'Manrope';font-weight:600;}","hooks":[],"popupRecs":[]},{"id":"rec602948715","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":30},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \">— наладить оптимальный паттерн дыхания;<br />— поработать над мобильностью грудной клетки: особенно важно «задвигать» верхний грудной отдел;<br />— вернуть позвоночнику его естественное движение, чтобы все суставы двигались — это артикуляция</div> </div> </div> </div>","css":"#rec602948715 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602951022","type":"33","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":15,"padding-bottom":15},"uc":[],"html":"<div class=\"t017\"> <div class=\"t-container t-align_left\"> <div class=\"t-col t-col_8 t-prefix_2\"> <h2 class=\"t017__title t-title t-title_xxs\" field=\"title\">2. Работа с лопатками — крайне важное условие</h2> </div> </div> </div>","css":"#rec602951022 .t017__title{font-family:'Manrope';font-weight:600;}","hooks":[],"popupRecs":[]},{"id":"rec602944855","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":30},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \">Необходимо наладить их работу и дать движение во всех плоскостях, а также наладить их взаимодействие с грудной клеткой</div> </div> </div> </div>","css":"#rec602944855 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602951199","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":15,"padding-bottom":45},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \"><strong style=\"font-weight: 700;\">Лопатка </strong>— это тенсегрити мышц: представьте её, как паутину, которая находится в центре. За какой край «паутину» потянут, туда лопатка и уйдет</div> </div> </div> </div>","css":"#rec602951199 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602944856","type":"3","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":0},"uc":[],"html":"<div class=\"t107\"> <div class=\"t-align_center\" itemscope itemtype=\"http://schema.org/ImageObject\"> <meta itemprop=\"image\" content=\"/img/t/t37356130-noroot.webp\"> <img class=\"t-img t-width t107__width t-width_6\" src=\"/img/t/t37356130-noroot.webp\" imgfield=\"img\" data-zoomable=\"yes\" data-img-zoom-url=\"images/tild3735-6130-4266-a634-643661643537__noroot.jpg\" alt=\"\"> </div> </div>","hooks":[],"popupRecs":[]},{"id":"rec602951567","type":"223","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":60,"padding-bottom":45},"uc":[],"html":"<div class=\"t195\"> <div class=\"t-container\"> <div class=\"t-col t-col_4 t-prefix_2\"> <div class=\"t195__text t-text t-text_md\" field=\"text\"><strong>Вариантом нормы </strong>является, когда эта «паутина» — упругая во всех направлениях и эластичная. А мы можем двигать лопатку во всех направлениях, она может удлиняться и быть в меру натянутой<br /><br />При идеальном положении лопатки мы можем увидеть у человека хорошую центрированную грудную клетку и достаточно широкий угол между ключицей и остью лопатки<br /><br />Когда голова, грудная клетка и таз будут находиться в одной плоскости, бонусом мы получим и<strong> плоский живот.</strong></div> </div> <div class=\"t-col t-col_4 t-prefix_1 t195__imgsection\" itemscope itemtype=\"http://schema.org/ImageObject\"><meta itemprop=\"image\" content=\"/img/t/t31346430-photo_2023-06-10_14-.webp\"> <img class=\"t195__img t-img\" src=\"/img/t/t31346430-photo_2023-06-10_14-.webp\" imgfield=\"img\" data-tu-max-width=\"1200\" data-tu-max-height=\"1200\" data-zoomable=\"yes\" data-img-zoom-url=\"images/tild3134-6430-4836-b939-626230346364__photo_2023-06-10_14-.jpg\" alt=\"\"><br /> <div class=\"t195__sectitle t-descr\" field=\"imgtitle\" itemprop=\"name\"></div> <div class=\"t195__secdescr t-descr\" field=\"imgdescr\" itemprop=\"description\"></div> </div> </div> </div>","hooks":[],"popupRecs":[]},{"id":"rec602944859","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":30},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \"><strong>Есть несколько так называемых «мышечных слингов» </strong>— это группы мышц, которые при грамотной работе дают эту свободу движения лопаткам<br /><br />Работа в концепции «слингов в движении» очень помогает уравновесить голову над грудной клеткой <br /><br /></div> </div> </div> </div>","css":"#rec602944859 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602951908","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":30},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \"><strong>Здесь не помогут «базовые» движения в тренажерном зале. </strong>К сожалению, если вы уже находитесь в данном паттерне, то сначала нам нужно распутать «клубок» компенсаций, а уже затем добавлять правильные силовые движения и укреплять мышцы <br /><br /><strong>Звучит сложно? Понимаю, это действительно непросто. </strong></div> </div> </div> </div>","css":"#rec602951908 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602944861","type":"106","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":30,"padding-bottom":45},"uc":[],"html":"<div class=\"t004\"> <div class=\"t-container \"> <div class=\"t-col t-col_8 t-prefix_2\"> <div field=\"text\" class=\"t-text t-text_md \">Все басни про холку — то же самое, что и басни про «косточку большого пальца». Нет, это не генетика<br /><br />Это, в первую очередь, нарушение биомеханики движения. И с этим также можно и нужно работать, чем мы и занимаемся <strong style=\"color: rgb(181, 97, 255);\">на курсах </strong><a href=\"/\" style=\"color: rgb(181, 97, 255);\"><strong><u>POPOVICHFIT.RU</u></strong></a></div> </div> </div> </div>","css":"#rec602944861 .t-text{font-family:'Manrope';}","hooks":[],"popupRecs":[]},{"id":"rec602952237","type":"3","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":0,"padding-bottom":45},"uc":[],"html":"<div class=\"t107\"> <div class=\"t-align_center\" itemscope itemtype=\"http://schema.org/ImageObject\"> <meta itemprop=\"image\" content=\"/img/t/t64376464-frame_2.webp\"> <img class=\"t-img t-width t107__width t-width_8\" src=\"/img/t/t64376464-frame_2.webp\" imgfield=\"img\" data-zoomable=\"yes\" data-img-zoom-url=\"images/tild6437-6464-4232-a435-306632346365__frame_2.png\" alt=\"\"> </div> </div>","hooks":[],"popupRecs":[]},{"id":"rec779581595","type":"131","vis":{"min":null,"max":null},"bg":null,"pad":{"padding-top":null,"padding-bottom":null},"uc":[],"css":"/* Укажи id блока, который нужно зафиксировать */ #rec779581596 { position: fixed; bottom: 0; left: 0; width: 100%; z-index: 9998; }","hooks":[],"popupRecs":[],"custom":"<!-- https://romanyu.ru/fiksirovannoe-menyu-zeroblock --> <style>\n/* Укажи id блока, который нужно зафиксировать */\n#rec779581596 {\n    position: fixe