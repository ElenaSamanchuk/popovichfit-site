# systemd: node-сервер Nitro (формы, корзина, вебхук, sitemap, 404). Файлы — /var/www/popovichfit/current
[Unit]
Description=popovichfit.ru (Nuxt/Nitro)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/popovichfit/current
EnvironmentFile=/var/www/popovichfit/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /var/www/popovichfit/current/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
