# Переменные окружения сервера (скопировать в .env на сервере; в dev — в .env локально).
# Уведомления о заявках/заказах (любой из каналов; без них — только журнал .data/*.jsonl):
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
NUXT_SMTP_URL=            # smtp://user:pass@smtp.host:465
NUXT_MAIL_TO=info@popovichfit.ru
# Оплата в корзине (/gift1 и др.): Public ID и API-секрет из личного кабинета CloudPayments
NUXT_PUBLIC_CLOUDPAYMENTS_PUBLIC_ID=
NUXT_CLOUDPAYMENTS_API_SECRET=
# Адрес сайта для canonical/og/sitemap
NUXT_PUBLIC_SITE_URL=https://popovichfit.ru
# Порт node-сервера (nginx проксирует на него)
PORT=3100
HOST=127.0.0.1
