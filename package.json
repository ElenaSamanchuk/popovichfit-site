{
  "name": "popovichfit-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev -p 3500",
    "build": "nuxt build && node scripts/postgenerate.mjs",
    "generate": "nuxt generate && node scripts/postgenerate.mjs",
    "preview": "sirv .output/public --port 3501 --single false",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "shoot:live": "node scripts/shoot-live.mjs",
    "shoot:local": "node scripts/shoot-local.mjs",
    "compare": "node scripts/compare.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:no-tilda": "node scripts/check-no-tilda.mjs",
    "verify:priority": "nice -n 15 node scripts/verify-priority.mjs",
    "images": "node scripts/import-images.mjs",
    "start": "node .output/server/index.mjs",
    "pages:sync": "python3 -I scripts/audit/build_pred_pages.py && python3 -I scripts/audit/extract_meta.py && python3 -I scripts/audit/gen_pages_ts.py && python3 -I scripts/audit/build_tilda_json.py && python3 -I scripts/audit/extract_block_css.py && node scripts/import-images-all.mjs --only-used && node scripts/import-og.mjs"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "cheerio": "^1.2.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
